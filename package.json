{
  "name": "emotime",
  "version": "0.2.0",
  "private": true,
  "description": "EmotiMe — 내 얼굴로 만드는 3초 이모티콘 (유료 미니앱)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "store:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\"",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy --warm-cache",
    "deploy:response-store": "cf deploy --prebuilt --mode production --worker emotime-response-store"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.1.5",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@sentry/nextjs": "^11.10.0",
    "@tosspayments/tosspayments-sdk": "^2.10.0",
    "@vinext/cloudflare": "^1.3.3",
    "clsx": "2.1.1",
    "gifenc": "1.0.3",
    "jszip": "3.10.1",
    "lucide-react": "0.451.0",
    "next": "^16.4.5",
    "posthog-js": "1.443.0",
    "posthog-node": "4.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "2.5.4",
    "vinext": "^1.4.3",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.11",
    "@types/node": "^26.6.6",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "autoprefixer": "10.4.20",
    "cf": "^1.0.0-beta.27",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.3",
    "vite": "^8.3.0"
  },
  "type": "module"
}
