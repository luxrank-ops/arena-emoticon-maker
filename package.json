{
  "name": "emotime",
  "version": "0.2.0",
  "private": true,
  "description": "EmotiMe — 내 얼굴로 만드는 3초 이모티콘 (유료 미니앱)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "store:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\""
  },
  "dependencies": {
    "clsx": "2.1.1",
    "gifenc": "1.0.3",
    "jszip": "3.10.1",
    "lucide-react": "0.451.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.3"
  }
}
