{
  "name": "emotime",
  "version": "0.2.0",
  "private": true,
  "description": "이모티학(EmotiHak) — 내 얼굴로 만드는 3초 이모티콘 (유료 미니앱)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-recommend-optimization.ts && node scripts/test-launch-readiness.mjs && tsx scripts/test-presets-150.ts && tsx scripts/test-free-trial.ts && tsx scripts/test-play-billing.ts && tsx scripts/test-studio-upgrade.ts && tsx scripts/test-pack-formats-flow.ts && tsx scripts/test-curation-packages.ts && tsx scripts/test-sample-cuts.ts && tsx scripts/test-paywall-unlock.ts && tsx scripts/test-referral.ts && tsx scripts/test-killer-packs.ts && tsx scripts/test-reviewer-sheet.ts && tsx scripts/test-drip-themes.ts && tsx scripts/test-ai-matte.ts && tsx scripts/test-photo-cutout.ts && tsx scripts/test-season-packs.ts",
    "smoke": "node scripts/smoke.mjs",
    "test:payments": "node scripts/test-payment-readiness.cjs",
    "test:checkout": "node scripts/test-checkout.mjs",
    "test:checkout:suspended": "node scripts/test-checkout-suspended.mjs",
    "preflight:payments": "node scripts/payment-preflight.mjs",
    "store:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\"",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy --warm-cache",
    "deploy:response-store": "cf deploy --prebuilt --mode production --worker emotime-response-store",
    "test:play": "tsx scripts/e2e-play-lib.ts",
    "test:play:static": "node scripts/test-play-static.mjs",
    "test:play:billing": "tsx scripts/test-play-billing.ts",
    "test:trial": "tsx scripts/test-free-trial.ts",
    "test:launch": "node scripts/test-launch-readiness.mjs",
    "test:text-effects": "tsx scripts/test-text-effects.ts",
    "test:studio": "tsx scripts/test-studio-upgrade.ts",
    "test:pack-flow": "tsx scripts/test-pack-formats-flow.ts",
    "test:i18n": "tsx scripts/test-i18n.ts",
    "test:failsafe": "tsx scripts/test-failsafe-sharing.ts",
    "test:quotes": "tsx scripts/test-quote-packs.ts",
    "test:presets": "tsx scripts/test-presets-150.ts",
    "test:curation": "tsx scripts/test-curation-packages.ts",
    "test:samples": "tsx scripts/test-sample-cuts.ts",
    "test:paywall": "tsx scripts/test-paywall-unlock.ts",
    "test:referral": "tsx scripts/test-referral.ts",
    "test:killer": "tsx scripts/test-killer-packs.ts",
    "test:review": "tsx scripts/test-reviewer-sheet.ts",
    "test:ai-matte": "tsx scripts/test-ai-matte.ts",
    "test:cutout": "tsx scripts/test-photo-cutout.ts",
    "test:season": "tsx scripts/test-season-packs.ts"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.1.5",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@sentry/nextjs": "^11.10.0",
    "@tosspayments/tosspayments-sdk": "^2.10.0",
    "@vinext/cloudflare": "^1.3.3",
    "clsx": "2.1.1",
    "gifenc": "1.0.3",
    "jszip": "3.10.1",
    "lucide-react": "0.451.0",
    "next": "^16.4.5",
    "posthog-js": "1.443.0",
    "posthog-node": "4.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "2.5.4",
    "vinext": "^1.4.3",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@bubblewrap/core": "^1.27.0",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.11",
    "@types/node": "^26.6.6",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "autoprefixer": "10.4.20",
    "cf": "^1.0.0-beta.27",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "^4.23.15",
