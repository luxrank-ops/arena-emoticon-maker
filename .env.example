# ─────────────────────────────────────────────────────────────
# EmotiMe · 환경변수 템플릿
#  cp .env.example .env.local  →  값이 없으면 DEMO_MODE 로 동작합니다.
# ─────────────────────────────────────────────────────────────

# ── 실행 모드 ────────────────────────────────────────────────
# web | toss | ios | android  (스토어 빌드에서는 웹 결제 UI가 자동 비노출)
NEXT_PUBLIC_PLATFORM=web
# 1 이면 AI/결제/DB 없이 절차적 SVG 렌더러 + 인메모리 저장소로 동작
DEMO_MODE=1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 데이터베이스 ─────────────────────────────────────────────
# 예: postgresql://user:pass@localhost:5432/emotime
DATABASE_URL=
# 로컬에서 DB 없이 돌릴 때: sqlite 파일 경로를 지정하면 자동 사용
SQLITE_PATH=./prisma/dev.db

# ── 인증 ────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# 앱인토스 로그인 (사업자 등록 후 발급)
TOSS_LOGIN_CLIENT_ID=
TOSS_LOGIN_CLIENT_SECRET=

# ── AI (Google Gemini) ──────────────────────────────────────
# 없으면 DEMO_MODE 렌더러로 폴백
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash
# 컷당 원가 상한(원) — 초과 시 잡 중단
AI_COST_CAP_KRW=60

# ── 데이터 저장 (파일 저장소) ───────────────────────────────
# 비우면 cwd/.data → (Vercel) /tmp/.data → os.tmpdir() 순으로 '쓸 수 있는 곳'을 자동 선택합니다.
# /tmp 는 인스턴스 로컬·휘발이므로 운영에서는 아래 KV 를 쓰세요.
DATA_DIR=

# ── 데이터 저장 (Vercel KV / Upstash Redis REST) ─────────────
# 두 값이 모두 있으면 파일 저장소 대신 원격 KV 를 사용합니다 (멀티 인스턴스 · 콜드스타트에도 유지).
# Vercel 대시보드에서 KV(Upstash) 연결 시 자동 주입되는 이름 그대로 쓰면 됩니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 단일 키에 JSON 스냅샷을 저장합니다 (CAS 로 동시 쓰기 보호)
KV_STORE_KEY=emotime:store

# ── 데이터 저장 (Firebase Firestore) ─────────────────────────
# FIREBASE_* 세 값이 있으면 KV 보다 우선해서 Firestore 를 씁니다.
# 서비스 계정 키: Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성.
# (Vercel 에 넣을 때는 FIREBASE_PRIVATE_KEY 의 개행을 \n 으로 유지해도 자동 처리됩니다)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# 저장 위치(컬렉션/문서) 와 청크 컬렉션
FIRESTORE_STORE_PATH=emotime/store
FIRESTORE_CHUNK_COLLECTION=emotime_store_chunks
# 저장 백엔드 고정: auto(기본, firestore → kv → 파일) | firestore | kv | file
STORE_BACKEND=auto
# 로컬 Firestore 에뮬레이터/스텁 사용 시 (host:port). 비우면 실제 Firestore
FIRESTORE_EMULATOR_HOST=

# ── 큐 / 캐시 ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# 없으면 인프로세스 큐로 폴백 (개발용)
QUEUE_DRIVER=memory

# ── 스토리지 (S3 / Cloudflare R2) ───────────────────────────
S3_ENDPOINT=
S3_REGION=ap-northeast-2
S3_BUCKET=emotime-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 얼굴 원본 파기 정책 (시간)
FACE_PURGE_HOURS=24
PRESIGN_TTL_SECONDS=900

# ── 결제: 토스페이먼츠 ──────────────────────────────────────
PAYMENT_PROVIDER=mock            # mock | toss | billing | iap
TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...
TOSS_WEBHOOK_SECRET=
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...

# ── 결제: 앱인토스 IAP ──────────────────────────────────────
TOSS_IAP_API_KEY=
TOSS_IAP_SKU_PLUS=
TOSS_IAP_SKU_STUDIO=

# ── 사업자 정보 (PG 심사: 푸터 필수 6항목) ─────────────────
NEXT_PUBLIC_BUSINESS_NAME=이모티미
NEXT_PUBLIC_BUSINESS_OWNER=홍길동
NEXT_PUBLIC_BUSINESS_REG_NO=000-00-00000
NEXT_PUBLIC_BUSINESS_ADDRESS=서울특별시 강남구 테헤란로 0
NEXT_PUBLIC_BUSINESS_TEL=02-000-0000
NEXT_PUBLIC_MAIL_ORDER_NO=제2026-서울강남-0000호
NEXT_PUBLIC_SUPPORT_EMAIL=support@emotime.app

# ── 굿즈 (POD 위탁) ────────────────────────────────────────
POD_PROVIDER=mock                # mock | printshop
POD_API_KEY=
POD_WEBHOOK_SECRET=

# ── 관측: Sentry (에러·성능) ────────────────────────────────
# DSN 이 비어 있으면 SDK 는 enabled:false 로 조용히 비활성 (로컬/CI 안전)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# 소스맵 업로드는 토큰이 있을 때만
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── 분석: PostHog (프로덕트 퍼널) ───────────────────────────
# 키가 없으면 모든 track() 이 no-op. 쿠키 미사용(persistence=memory)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

SLACK_WEBHOOK_URL=

# ── 크론 보안 ───────────────────────────────────────────────
# 얼굴 파기 크론(/api/cron/purge)은 이 값이 없으면 운영에서 실행을 거부합니다.
CRON_SECRET=change-me
# 얼굴 파기 기회적 스윕 주기(ms). 크론이 없는 환경의 안전망. 기본 5분
FACE_PURGE_SWEEP_MS=300000

# ── 운영 콘솔 ───────────────────────────────────────────────
# 운영(NODE_ENV=production)에서는 이 값이 없으면 관리자 로그인이 차단됩니다(fail-closed).
# 로컬/데모에서는 미설정 시 'emotime-demo'.
ADMIN_PASSCODE=

# ── 요청 제한 ───────────────────────────────────────────────
# 1 이면 레이트리밋 비활성 (부하 테스트 전용 — 운영에서는 켜 둘 것)
RATE_LIMIT_DISABLED=0
