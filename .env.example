# =============================================================================
# Arena Emoticon Maker - Environment Variables
# =============================================================================
# 이 파일을 .env.local로 복사하고 실제 값으로 채우세요.
# 프로덕션에서는 시크릿 관리 시스템(Vault, AWS Secrets Manager 등) 사용 권장

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://arena:arena_password@localhost:5432/arena_emoticon?schema=public
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena_password
POSTGRES_DB=arena_emoticon

# =============================================================================
# Redis (BullMQ Queue)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Authentication (OAuth)
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# Stripe (Payments & Subscriptions) - 해외 결제용
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_BUSINESS=price_business_monthly

# =============================================================================
# Toss Payments (토스페이먼츠) - 국내 결제용 (추천)
# =============================================================================
# 가입: https://docs.tosspayments.com/
# 테스트 키 발급: https://docs.tosspayments.com/reference#테스트-모드
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_your_client_key
TOSS_SECRET_KEY=test_sk_your_secret_key
TOSS_WEBHOOK_SECRET=your_webhook_secret_from_toss_dashboard

# =============================================================================
# Email (Resend)
# =============================================================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# Supabase (Image Storage)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=emoticons

# =============================================================================
# AI Services
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key

# =============================================================================
# Monitoring & Alerts
# =============================================================================
# Sentry
SENTRY_DSN=https://your-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Slack Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# =============================================================================
# Cron Jobs
# =============================================================================
CRON_SECRET=your-cron-secret-key

# =============================================================================
# Web Push Notifications (VAPID)
# =============================================================================
# 생성 방법: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_WEB_PUSH=true
ENABLE_SLACK_ALERTS=true
ENABLE_SENTRY=true