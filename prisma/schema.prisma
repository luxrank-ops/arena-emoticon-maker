generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(USER)
  credits       Int       @default(10) // 무료 크레딧 10개 제공
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  emoticons     Emoticon[]
  generations   Generation[]
  subscriptions Subscription?
  payments      Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Emoticon {
  id          String   @id @default(cuid())
  userId      String
  name        String
  concept     String   @db.Text
  basePrompt  String   @db.Text
  style       String   @default("3d-disney-pixar")
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations Generation[]
}

model Generation {
  id            String        @id @default(cuid())
  userId        String
  emoticonId    String?
  prompt        String        @db.Text
  revisedPrompt String?       @db.Text
  imageUrl      String?
  thumbnailUrl  String?
  emotion       String
  dialogue      String?
  style         String
  model         String        @default("dall-e-3")
  size          String        @default("1024x1024")
  quality       String        @default("standard")
  status        GenStatus     @default(PENDING)
  error         String?
  creditsUsed   Int           @default(1)
  generationTime Int?         // milliseconds
  seed          Int?
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoticon   Emoticon?  @relation(fields: [emoticonId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?
  tossCustomerId       String?  @unique
  tossBillingKey       String?  @unique
  tossSubscriptionId   String?  @unique
  plan                 Plan     @default(FREE)
  status               SubStatus @default(ACTIVE)
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String      @id @default(cuid())
  userId          String
  stripePaymentIntentId String? @unique
  tossPaymentKey  String?     @unique
  amount          Int         // 원 단위 (토스는 원 단위)
  currency        String      @default("krw")
  status          PaymentStatus @default(PENDING)
  creditsGranted  Int         @default(0)
  description     String?
  metadata        Json?
  provider        String      @default("stripe") // "stripe" | "toss"
  createdAt       DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([provider, status])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  message     String
  priority    String   @default("normal")
  data        Json?
  actionUrl   String?
  actionLabel String?
  read        Boolean  @default(false)
  readAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([type])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  keys      Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

enum Role {
  USER
  ADMIN
  CREATOR
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum GenStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}